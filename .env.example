# Azure Computer Vision の認証情報（Azureポータル > リソース > キーとエンドポイント）
# このファイルを .env にコピーして実際の値を記入してください
AZURE_VISION_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com
AZURE_VISION_KEY=<your-key>

# Supabase（設定するとDBがSupabaseに切り替わる。未設定ならローカルSQLite）
# Supabaseダッシュボード > Project Settings > API から取得
# 事前に supabase_schema.sql を SQL Editor で実行しておくこと
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-anon-key>
